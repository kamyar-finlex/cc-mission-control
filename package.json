{
  "name": "cc-mission-control",
  "version": "0.1.0",
  "description": "A live mission-control dashboard for all your local Claude Code sessions. Unofficial, not affiliated with Anthropic.",
  "type": "module",
  "bin": {
    "cc-mission-control": "bin/cli.mjs"
  },
  "scripts": {
    "start": "node bin/cli.mjs",
    "check": "for f in server.mjs statusline.mjs bin/cli.mjs lib/*.mjs src/*.mjs public/js/*.js test/*.mjs; do node --check \"$f\" || exit 1; done && node test/check-page.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "avatar/",
    "bin/",
    "lib/",
    "public/",
    "skills/",
    "src/",
    "server.mjs",
    "statusline.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "dashboard",
    "agents",
    "sessions",
    "mission-control"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamyar-finlex/cc-mission-control.git"
  },
  "bugs": {
    "url": "https://github.com/kamyar-finlex/cc-mission-control/issues"
  },
  "homepage": "https://github.com/kamyar-finlex/cc-mission-control#readme"
}
